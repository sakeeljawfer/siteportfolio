---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import ServiceTiles from '~/components/widgets/ServiceTiles.astro';

const services = await getCollection('services');

const metadata = {
  title: 'Services',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <section data-reveal class="section-divider">
    <Hero2
      tagline="Services"
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?q=80&w=2000&auto=format&fit=crop',
      alt: 'Our Services',
    }}
  >
      <Fragment slot="title">
        Elevate your online presence with our <br />
        <span class="text-accent dark:text-white highlight"> Tailored services</span>
      </Fragment>

      <Fragment slot="subtitle">
        Revitalize your digital landscape with our tailored suite of services. From web and mobile app development to
        strategic digital marketing, we specialize in scalable solutions, user-centric design, and cutting-edge
        technologies. Our commitment to impeccable quality is reinforced through rigorous QA processes, while our UI/UX
        expertise enhances user engagement. With technical consultation services, we offer expert guidance to optimize
        your technological infrastructure. Elevate your online presence and achieve impactful results through our holistic
        and innovative digital solutions
      </Fragment>
    </Hero2>
  </section>
  <section data-reveal class="section-divider">
    <ServiceTiles
      title="Explore our core services"
      subtitle="Each service has a dedicated page with tailored outcomes, process details, and example results."
      items={services.map((service) => ({
        title: service.data.title,
        description: service.data.description,
        href: `/services/${service.slug}`,
        icon: {
          'web-development': 'tabler:browser',
          'web-app-development': 'tabler:world-www',
          'mobile-app-development': 'tabler:device-mobile-code',
          'digital-marketing': 'tabler:speakerphone',
          'seo-optimization': 'tabler:search',
          'ui-ux-design': 'tabler:palette',
          'quality-assurance': 'tabler:zoom-code',
          msp: 'tabler:server',
          pos: 'tabler:credit-card',
          'technical-consultation': 'tabler:bulb',
        }[service.slug],
      }))}
    />
  </section>

  <!-- CallToAction Widget *********** -->

  <section data-reveal class="section-divider">
    <CallToAction
      actions={[
        {
          variant: 'primary',
          text: 'Tell us your story',
          href: '/contact',
        },
      ]}
      title="Feeling inspired?"
      subtitle="Transform your projects, whether in business, design, or education, with our exceptional services. Ready to elevate your business? Contact us now to get started!    "
    />
  </section>
</Layout>
