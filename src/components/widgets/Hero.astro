---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import type { CallToAction } from '~/types';

export interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  tagline?: string;
  content?: string;
  actions?: string | CallToAction[];
  image?: string | any; // TODO: find HTMLElementProps
}

const {
  title = await Astro.slots.render('title'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),
} = Astro.props;
---

<script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
<script>
  const particleConfig = {
    particles: {
      number: {
        value: 10000,
        density: { enable: true, value_area: 600 },
      },
      color: { value: ['#ffffff', '#b6d5ff', '#3cb5b0'] },
      shape: { type: 'circle' },
      opacity: {
        value: 1,
        random: true,
        anim: { enable: true, speed: 0.3, opacity_min: 0.2, sync: false },
      },
      size: { value: 2.2, random: true },
      line_linked: {
        enable: false,
      },
      move: {
        enable: true,
        speed: 0.12,
        direction: 'top',
        out_mode: 'out',
      },
    },
    interactivity: {
      events: {
        onhover: { enable: true, mode: 'repulse' },
        onclick: { enable: true, mode: 'push' },
        resize: true,
      },
      modes: {
        repulse: { distance: 140, duration: 0.4 },
        push: { particles_nb: 3 },
      },
    },
    retina_detect: true,
  };

  const initParticles = () => {
    if (window.particlesJS) {
      window.particlesJS('particlesWrapper', particleConfig);
    }
  };

  const initParallax = () => {
    const hero = document.getElementById('hero-parallax');
    if (!hero) return;
    const layers = hero.querySelectorAll('[data-parallax-layer]');
    hero.addEventListener('mousemove', (event) => {
      const rect = hero.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      layers.forEach((layer, index) => {
        const depth = (index + 1) * 8;
        layer.style.transform = `translate3d(${x * depth}px, ${y * depth}px, 0)`;
      });
    });
    hero.addEventListener('mouseleave', () => {
      layers.forEach((layer) => {
        layer.style.transform = 'translate3d(0, 0, 0)';
      });
    });
  };

  const initAll = () => {
    initParticles();
    initParallax();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>

<div class="hero-container space-hero" data-reveal id="hero-parallax">
  <div id="particlesWrapper"></div>
  <div class="starfield" aria-hidden="true"></div>
  <div class="hero-overlay"></div>
  <div class="hero-content py-6 md:py-10">
    <div>
      {
        image && (
          <div class="relative m-auto max-w-5xl hero-visual" data-parallax-layer>
            {typeof image === 'string' ? (
              <Fragment set:html={image} />
            ) : (
              <Image
                class="mx-auto w-full hero-image floater"
                sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                loading="eager"
                width={1024}
                height={576}
                {...image}
              />
            )}
          </div>
        )
      }
    </div>
    <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto relative z-10" data-parallax-layer>
      {
        title && (
          <h1
            class="text-white text-3xl md:text-6xl font-bold leading-tight tracking-tight mb-4 font-heading"
            set:html={title}
          />
        )
      }
      <div class="max-w-3xl mx-auto mt-8">
        {
          actions && (
            <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4">
              {Array.isArray(actions) ? (
                actions.map((action) => (
                  <div class="flex w-full sm:w-auto">
                    <Button {...(action || {})} class="w-full sm:mb-0" />
                  </div>
                ))
              ) : (
                <Fragment set:html={actions} />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  .hero-container {
    width: 100vw;
    position: relative;
    padding: 2.5rem 0 1.5rem;
    background: radial-gradient(circle at 20% 10%, rgba(19, 76, 132, 0.92), rgba(3, 6, 32, 0.98));
    overflow: hidden;
  }

  #particlesWrapper {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    pointer-events: none;
  }

  .starfield {
    position: absolute;
    inset: -20%;
    z-index: 2;
    pointer-events: none;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(255, 255, 255, 0.9) 50%, transparent 60%),
      radial-gradient(1px 1px at 30% 80%, rgba(255, 255, 255, 0.8) 50%, transparent 60%),
      radial-gradient(1px 1px at 70% 30%, rgba(182, 213, 255, 0.8) 50%, transparent 60%),
      radial-gradient(1px 1px at 90% 70%, rgba(60, 181, 176, 0.7) 50%, transparent 60%),
      radial-gradient(2px 2px at 50% 50%, rgba(255, 255, 255, 0.7) 50%, transparent 60%);
    background-size: 200px 200px, 260px 260px, 320px 320px, 420px 420px, 520px 520px;
    animation: starDrift 60s linear infinite;
    opacity: 1;
  }

  .starfield::before,
  .starfield::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 15% 10%, rgba(255, 255, 255, 0.9) 50%, transparent 60%),
      radial-gradient(1px 1px at 45% 60%, rgba(255, 255, 255, 0.8) 50%, transparent 60%),
      radial-gradient(1px 1px at 75% 40%, rgba(182, 213, 255, 0.8) 50%, transparent 60%),
      radial-gradient(1px 1px at 85% 85%, rgba(60, 181, 176, 0.7) 50%, transparent 60%);
    background-size: 180px 180px, 240px 240px, 300px 300px, 380px 380px;
    opacity: 0.8;
    animation: starTwinkle 8s ease-in-out infinite;
  }

  .starfield::after {
    filter: blur(0.4px);
    opacity: 0.6;
    animation-duration: 12s;
  }

  #particlesWrapper canvas {
    position: absolute;
    inset: 0;
    opacity: 0.9;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(60, 181, 176, 0.12), transparent 45%),
      radial-gradient(circle at 15% 80%, rgba(19, 76, 132, 0.3), transparent 55%),
      radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.04), transparent 60%),
      linear-gradient(120deg, rgba(19, 76, 132, 0.45), rgba(3, 6, 32, 0.9));
    z-index: 1;
    animation: spaceGlow 18s ease-in-out infinite;
    pointer-events: none;
  }

  .hero-overlay::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 35%, rgba(3, 6, 32, 0.75) 100%);
  }

  .hero-overlay::before {
    content: '';
    position: absolute;
    inset: -10%;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(255, 255, 255, 0.6) 50%, transparent 60%),
      radial-gradient(1px 1px at 30% 80%, rgba(255, 255, 255, 0.5) 50%, transparent 60%),
      radial-gradient(1px 1px at 70% 30%, rgba(182, 213, 255, 0.6) 50%, transparent 60%),
      radial-gradient(1px 1px at 90% 70%, rgba(60, 181, 176, 0.45) 50%, transparent 60%),
      radial-gradient(2px 2px at 50% 50%, rgba(255, 255, 255, 0.5) 50%, transparent 60%);
    background-size: 200px 200px, 260px 260px, 320px 320px, 420px 420px, 520px 520px;
    opacity: 0.8;
    animation: starDrift 40s linear infinite;
  }

  .hero-content {
    position: relative;
    z-index: 4;
  }

  .hero-visual {
    padding: 1rem;
    border-radius: 2rem;
    transition: transform 0.3s ease;
  }

  .hero-image {
  }

  .floater {
    animation: floatAnimation 4s ease-in-out infinite;
    filter: none;
  }

  @keyframes spaceGlow {
    0%,
    100% {
      filter: brightness(1);
    }
    50% {
      filter: brightness(1.1);
    }
  }

  @keyframes starTwinkle {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes starDrift {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-80px, 120px, 0);
    }
  }

  @keyframes floatAnimation {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-25px);
    }
  }

  @media only screen and (max-width: 767px) {
    @keyframes floatAnimation {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(25px);
      }
    }
  }
</style>
