---
import { Icon } from 'astro-icon/components';

export interface ServiceItem {
  title: string;
  description: string;
  href: string;
  icon?: string;
}

export interface Props {
  title: string;
  subtitle?: string;
  items: ServiceItem[];
}

const { title, subtitle, items } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 md:px-6 py-10 md:py-14 text-default">
  <div class="text-center">
    <p class="text-xs uppercase tracking-[0.3em] text-muted font-semibold">Services</p>
    <h2 class="mt-3 text-4xl md:text-5xl font-semibold tracking-tight text-heading">
      {title}
    </h2>
    {subtitle ? <p class="mt-4 text-muted text-lg">{subtitle}</p> : null}
  </div>

  <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {items.map((service) => (
      <a class="card shadow-brand p-6 transition-all duration-300 hover:-translate-y-0.5" href={service.href}>
        <div class="flex items-center gap-3">
          <span class="neon-badge">
            {service.icon ? (
              <Icon name={service.icon} class="w-5 h-5" />
            ) : (
              <span class="sr-only">{service.title}</span>
            )}
          </span>
          <h3 class="text-lg font-semibold text-heading">{service.title}</h3>
        </div>
        <p class="mt-3 text-sm text-muted">{service.description}</p>
        <span class="mt-6 inline-flex text-sm font-semibold text-primary">View service →</span>
      </a>
    ))}
  </div>
</section>
