---
import type { Headline } from "~/types";
import { twMerge } from "tailwind-merge";

const {
  title = await Astro.slots.render("title"),
  subtitle = await Astro.slots.render("subtitle"),
  tagline,
  classes = {},
} = Astro.props as Headline;

const {
  container: containerClass = "max-w-3xl",
  title: titleClass = "text-4xl md:text-5xl font-semibold tracking-tight",
  subtitle: subtitleClass = "text-lg md:text-xl",
} = classes;
---

{
  (title || subtitle || tagline) && (
    <div
      class={twMerge("mb-8 md:mx-auto md:mb-12 text-center", containerClass)}
    >
      {tagline && (
        <p
          class="text-xs uppercase tracking-[0.3em] text-muted font-semibold"
          set:html={tagline}
        />
      )}
      {title && (
        <h2
          class={twMerge(
            "leading-tight font-heading text-heading",
            titleClass
          )}
          set:html={title}
        />
      )}

      {subtitle && (
        <p
          class={twMerge("mt-4 text-muted", subtitleClass)}
          set:html={subtitle}
        />
      )}
    </div>
  )
}
